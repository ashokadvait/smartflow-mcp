NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DEFAULT_TENANT_NAME="Default Tenant"
DEFAULT_TIMEZONE=Asia/Kolkata

# Database & Queue
DATABASE_URL=postgresql://smartflow:local_dev_password@localhost:5432/smartflow_intelligence
REDIS_URL=redis://localhost:6379

# Smartflo (Tata Tele Business Services)
SMARTFLOW_BASE_URL=https://api-smartflo.tatateleservices.com/v1
SMARTFLOW_API_KEY=
# Optional: only needed if using JWT login instead of Portal API Token
SMARTFLOW_EMAIL=
SMARTFLOW_PASSWORD=
SMARTFLOW_ALLOWED_MEDIA_HOSTS=cloudphone.tatateleservices.com
SMARTFLOW_RATE_LIMIT_RPS=5
SMARTFLOW_WEBHOOK_SECRET=

# Transcription Provider
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# AI Analysis Provider
ANALYSIS_PROVIDER=groq
ANALYSIS_MODEL=openai/gpt-oss-120b
ANALYSIS_FALLBACK_PROVIDER=

# Provider API Keys (keep secret, never commit)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYSIS_MODEL=llama3.1

# Audio Storage
AUDIO_STORAGE_PROVIDER=local
AUDIO_STORAGE_PATH=./storage/audio
MAX_AUDIO_SIZE_MB=25

# Security (generate 64-hex-char keys for production)
MCP_API_KEY=
ENCRYPTION_KEY=
PHONE_HASH_SECRET=

